# Copy this file to backend/.env and fill values locally. Never commit backend/.env.
ENVIRONMENT=development
TRADING_MODE=paper
BACKEND_CORS_ORIGINS=http://localhost:5173
DEV_OTP_PREVIEW=true
SMS_PROVIDER=development
SESSION_TTL_DAYS=30
REGISTRATION_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PHONE_LIMIT=5
OTP_IP_LIMIT=20
OTP_RATE_WINDOW_SECONDS=900

# Neon pooled URL for normal application traffic.
DATABASE_URL=

# Neon direct URL reserved for future Alembic migrations.
DATABASE_URL_UNPOOLED=

# Upstash Redis REST credentials from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a private random value used to HMAC OTPs before caching them.
OTP_HASH_SECRET=

REDIS_KEY_PREFIX=trinex

# Paper execution worker. The backend rejects any non-paper/live provider value.
MARKET_DATA_PROVIDER=mock
EXECUTION_POLL_INTERVAL_SECONDS=1
EXECUTION_LEASE_SECONDS=30
EXECUTION_HEARTBEAT_SECONDS=10
